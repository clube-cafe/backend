# Banco de dados
DB_DIALECT=postgres
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Servidor
PORT=3000
NODE_ENV=development

# Autenticação
JWT_SECRET=
JWT_EXPIRES_IN=1h

# CORS — origens permitidas (CSV). Ex.: http://localhost:3001,https://app.clubecafe.com
FRONTEND_URL=

# Logs (qualquer valor não vazio habilita Logger.debug)
DEBUG=

# Seed do admin (opcional — npm run insert-admin lê estas vars antes de cair em modo interativo)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
